{
  "name": "termloop",
  "version": "0.5.1",
  "description": "Browser-based OS-like UI for managing remote servers via SSH",
  "author": {
    "name": "Satyam Lohiya",
    "url": "https://github.com/betaversionio"
  },
  "homepage": "https://github.com/betaversionio/termloop#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/betaversionio/termloop.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/betaversionio/termloop/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "termloop": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "build": "tsdown",
    "bundle": "node scripts/bundle.mjs",
    "dev": "tsc --watch --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/s3-request-presigner": "^3.1137.0",
    "@google-cloud/storage": "^8.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/platform-ws": "^12.0.4",
    "@nestjs/websockets": "^12.0.4",
    "archiver": "^7.0.1",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "open": "^11.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sql.js": "^1.14.2",
    "ssh2": "^1.17.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@termloop/client": "workspace:*",
    "@types/express": "^5.0.6",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "ssh",
    "server",
    "terminal",
    "sftp",
    "devops",
    "server-management",
    "remote-server",
    "web-terminal",
    "file-manager",
    "ssh-client"
  ]
}
