{
  "name": "termloop-vscode",
  "displayName": "SSH Agent - Termloop",
  "description": "Manage remote SSH servers, terminals, and files without leaving VS Code",
  "version": "0.1.0",
  "private": true,
  "publisher": "BetaVersion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/betaversionio/termloop.git",
    "directory": "apps/vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "**/.termloop/commands.json",
        "url": "./schemas/commands.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "termloop",
          "title": "TermLoop",
          "icon": "media/connections.svg"
        }
      ]
    },
    "views": {
      "termloop": [
        {
          "id": "termloopConnections",
          "name": "Connections",
          "icon": "media/connections.svg"
        },
        {
          "id": "termloopSessions",
          "name": "Active Sessions",
          "icon": "media/connections.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "termloop.refreshConnections",
        "title": "TermLoop: Refresh Connections",
        "icon": "$(refresh)"
      },
      {
        "command": "termloop.addConnection",
        "title": "TermLoop: Add Connection",
        "icon": "$(add)"
      },
      {
        "command": "termloop.openTerminal",
        "title": "TermLoop: Open Terminal"
      },
      {
        "command": "termloop.browseFiles",
        "title": "TermLoop: Browse Files",
        "icon": "$(folder-opened)"
      },
      {
        "command": "termloop.openConnectionInBrowser",
        "title": "TermLoop: Open Connection in Browser",
        "icon": "$(globe)"
      },
      {
        "command": "termloop.openOsDesktop",
        "title": "TermLoop: Open OS Desktop",
        "icon": "$(window)"
      },
      {
        "command": "termloop.copyMcpConnectCommand",
        "title": "TermLoop: Copy Claude MCP Connect Command",
        "icon": "$(copy)"
      },
      {
        "command": "termloop.refreshSessions",
        "title": "TermLoop: Refresh Active Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "termloop.attachSessionTerminal",
        "title": "TermLoop: Attach to Session"
      },
      {
        "command": "termloop.copySessionId",
        "title": "TermLoop: Copy Session ID",
        "icon": "$(copy)"
      },
      {
        "command": "termloop.openSessionInBrowser",
        "title": "TermLoop: Open Session in Browser",
        "icon": "$(globe)"
      },
      {
        "command": "termloop.insertCommandAlias",
        "title": "TermLoop: Insert Command Alias"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "termloop.addConnection",
          "when": "view == termloopConnections",
          "group": "navigation"
        },
        {
          "command": "termloop.refreshConnections",
          "when": "view == termloopConnections",
          "group": "navigation"
        },
        {
          "command": "termloop.copyMcpConnectCommand",
          "when": "view == termloopConnections",
          "group": "navigation"
        },
        {
          "command": "termloop.refreshSessions",
          "when": "view == termloopSessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "termloop.openTerminal",
          "when": "view == termloopConnections && viewItem == termloopConnection"
        },
        {
          "command": "termloop.browseFiles",
          "when": "view == termloopConnections && viewItem == termloopConnection",
          "group": "inline"
        },
        {
          "command": "termloop.openConnectionInBrowser",
          "when": "view == termloopConnections && viewItem == termloopConnection",
          "group": "inline"
        },
        {
          "command": "termloop.openOsDesktop",
          "when": "view == termloopConnections && viewItem == termloopConnection"
        },
        {
          "command": "termloop.attachSessionTerminal",
          "when": "view == termloopSessions && viewItem == termloopSession"
        },
        {
          "command": "termloop.copySessionId",
          "when": "view == termloopSessions && viewItem == termloopSession",
          "group": "inline"
        },
        {
          "command": "termloop.openSessionInBrowser",
          "when": "view == termloopSessions && viewItem == termloopSession",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "dev": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@termloop/client": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  }
}
