[
  {
    "id": "image-viewer",
    "name": "Image Viewer",
    "description": "View images from your remote server with zoom and fit controls.",
    "author": "TermLoop",
    "version": "1.0.0",
    "iconUrl": "/marketplace-icons/image-viewer.svg",
    "bundleUrl": "/marketplace-apps/image-viewer.js",
    "fileAssociations": [".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp", ".bmp", ".ico"],
    "defaultSize": { "width": 800, "height": 600 },
    "minWidth": 400,
    "minHeight": 300,
    "showOnDesktop": false,
    "showInDock": false,
    "category": "media"
  },
  {
    "id": "docker-manager",
    "name": "Docker",
    "description": "Manage Docker containers and images on the connected server",
    "author": "TermLoop",
    "version": "0.1.0",
    "iconUrl": "/marketplace-icons/docker.webp",
    "bundleUrl": "/marketplace-apps/docker-manager.js",
    "fileAssociations": [],
    "defaultSize": { "width": 820, "height": 560 },
    "minWidth": 560,
    "minHeight": 380,
    "showOnDesktop": true,
    "showInDock": true,
    "category": "development"
  }
]
