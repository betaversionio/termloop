{
  "name": "termloop-monorepo",
  "description": "Browser-based OS-like UI for managing remote servers via SSH",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Satyam Lohiya",
    "url": "https://github.com/betaversionio"
  },
  "homepage": "https://github.com/betaversionio/termloop#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/betaversionio/termloop.git"
  },
  "bugs": {
    "url": "https://github.com/betaversionio/termloop/issues"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @termloop/web dev",
    "dev:server": "pnpm --filter @termloop/server dev",
    "build": "turbo build",
    "build:pkg": "turbo build && pnpm --filter termloop bundle",
    "link:cli": "cd apps/cli && pnpm link --global",
    "unlink:cli": "pnpm uninstall --global termloop",
    "pack:cli": "cd apps/cli && pnpm pack",
    "publish:dry": "cd apps/cli && pnpm publish --dry-run --no-git-checks",
    "publish:npm": "cd apps/cli && pnpm publish --no-git-checks",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "validate-catalog": "node scripts/validate-catalog.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.4.2"
}
